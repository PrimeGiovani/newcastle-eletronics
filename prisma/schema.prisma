// PostgreSQL schema for products, content and leads.
generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }

model Category {
  id              String     @id @default(cuid())
  slug            String     @unique              // seo url: /products/{slug}
  name            String
  description     String?
  image           String?
  parentId        String?                          // e.g. "Hybrid Inverters" -> "Solar Solutions"
  parent          Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children        Category[] @relation("CategoryTree")
  sortOrder       Int        @default(0)
  metaTitle       String?
  metaDescription String?
  products        Product[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model Brand {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  logo     String?
  products Product[]
}

model Product {
  id              String         @id @default(cuid())
  slug            String         @unique
  sku             String         @unique
  name            String
  tagline         String?
  description     String         @db.Text
  categoryId      String
  category        Category       @relation(fields: [categoryId], references: [id])
  brandId         String?
  brand           Brand?         @relation(fields: [brandId], references: [id])
  price           Decimal        @db.Decimal(12, 2)
  compareAtPrice  Decimal?       @db.Decimal(12, 2)
  currency        String         @default("NGN")
  stockQty        Int            @default(0)
  status          ProductStatus  @default(DRAFT)
  featured        Boolean        @default(false)
  warranty        String?
  highlights      String[]
  badges          String[]
  metaTitle       String?
  metaDescription String?
  images          ProductImage[]
  specs           ProductSpec[]
  leads           Lead[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  @@index([categoryId, status])
  @@index([featured])
}

enum ProductStatus { DRAFT ACTIVE ARCHIVED }

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String                                 // required for accessibility/SEO
  width     Int?
  height    Int?
  sortOrder Int     @default(0)
  @@index([productId])
}

model ProductSpec {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  group     String? // e.g. "Electrical", "Dimensions"
  label     String  // e.g. "Cooling capacity"
  value     String  // e.g. "12,000 BTU"
  sortOrder Int     @default(0)
  @@index([productId])
}

model Lead {
  id         String     @id @default(cuid())
  name       String
  phone      String
  email      String?
  message    String?    @db.Text
  productId  String?
  product    Product?   @relation(fields: [productId], references: [id])
  productRaw String?    // free-text selection ("Free Solar Consultation")
  source     LeadSource @default(WEBSITE)
  status     LeadStatus @default(NEW)
  utm        Json?
  createdAt  DateTime   @default(now())
  @@index([status, createdAt])
}

enum LeadSource { WEBSITE WHATSAPP PHONE WALKIN }
enum LeadStatus { NEW CONTACTED QUOTED WON LOST }

model Post {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  excerpt         String
  body            String   @db.Text  // MDX/Markdown
  coverImage      String?
  category        String?
  author          String
  published       Boolean  @default(false)
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  updatedAt       DateTime @updatedAt
}

model Project {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  sector    String   // Hotel, Office, Residential, Developer
  summary   String
  body      String?  @db.Text
  images    String[]
  location  String?
  capacity  String?  // e.g. "20KW / 30KWh"
  createdAt DateTime @default(now())
}
