# ─── Site ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.newcastleelectronics.com
NEXT_PUBLIC_WHATSAPP_NUMBER=2347068376168      # digits only, international format
# Customer sign-in / register (email + Google) and My Account. off = guest checkout only (staff still log in at /auth/login)
NEXT_PUBLIC_CUSTOMER_ACCOUNTS=off

# ─── Supabase (Project Settings → API) ────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # server only – NEVER expose to the browser

# ─── Paystack (Dashboard → Settings → API Keys & Webhooks) ─
PAYSTACK_SECRET_KEY=sk_test_xxx                 # server only
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx

# ─── Email receipts (optional – https://resend.com) ───
RESEND_API_KEY=
EMAIL_FROM="Newcastle Electronics <info@newcastleelectronics.com>"
ADMIN_NOTIFY_EMAIL=info@newcastleelectronics.com
CRON_SECRET=generate-a-long-random-string
